#--------------------------------------------------------------------
# APLIKASI
#--------------------------------------------------------------------
CI_ENVIRONMENT = production
APP_BASE_URL = 'https://domain-anda.com'
APP_KEY = 'ganti-dengan-32-karakter-acak'

#--------------------------------------------------------------------
# SEO
# Sitemap otomatis di /sitemap.xml dan robots di /robots.txt.
# Isi token dari Google Search Console setelah domain terdaftar.
#--------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION = ''

#--------------------------------------------------------------------
# IDENTITAS USAHA
# STORE_NAME boleh kosong selama belum ada nama.
#--------------------------------------------------------------------
STORE_NAME = ''
STORE_TAGLINE = 'Template stok siap pakai untuk usaha kecil'
STORE_EMAIL = 'halo@namausaha.test'
STORE_WHATSAPP = ''
STORE_ADDRESS = 'Alamat usaha belum diatur'
STORE_PRODUCER = 'Nexus Diji'
INVOICE_PREFIX = 'INV'

APP_ADMIN_NAME = 'Admin'
APP_ADMIN_EMAIL = 'admin@nexusdiji.test'
APP_ADMIN_PASSWORD_HASH = '$2y$12$ganti-dengan-hash-password-hash'
ADMIN_NOTIFY_EMAIL = 'admin@nexusdiji.test'

#--------------------------------------------------------------------
# DATABASE
# Produksi Vercel: isi DATABASE_URL dari Neon (direct, bukan -pooler).
# Jika memakai integrasi Neon-Vercel, DATABASE_URL_UNPOOLED lebih dipilih.
# Lokal: biarkan DATABASE_URL kosong dan pakai SQLite di .env.
#--------------------------------------------------------------------
DATABASE_URL = ''
DATABASE_URL_UNPOOLED = ''
DB_DRIVER = Postgre
DB_HOST = ''
DB_PORT = 5432
DB_DATABASE = ''
DB_USERNAME = ''
DB_PASSWORD = ''
DB_SSLMODE = require
DB_DEBUG = false

#--------------------------------------------------------------------
# SESI
# Vercel memakai sesi database karena filesystem tidak persisten.
#--------------------------------------------------------------------
SESSION_DRIVER = database
SESSION_TABLE = ci_sessions
SESSION_DB_GROUP = default
SESSION_COOKIE_NAME = nexus_session
SESSION_EXPIRATION = 7200
SESSION_MATCH_IP = false
COOKIE_SECURE = true

#--------------------------------------------------------------------
# PEMBAYARAN
# driver: sandbox atau midtrans
#--------------------------------------------------------------------
PAYMENT_DRIVER = midtrans
PAYMENT_EXPIRY_HOURS = 24
MIDTRANS_SERVER_KEY = ''
MIDTRANS_CLIENT_KEY = ''
MIDTRANS_IS_PRODUCTION = true
MIDTRANS_SNAP_URL = ''
MIDTRANS_API_URL = ''

#--------------------------------------------------------------------
# EMAIL
# driver: file atau smtp
#--------------------------------------------------------------------
MAIL_DRIVER = smtp
MAIL_FROM_EMAIL = 'email-anda@gmail.com'
MAIL_FROM_NAME = ''
MAIL_SMTP_HOST = 'smtp.gmail.com'
MAIL_SMTP_PORT = 587
MAIL_SMTP_USER = 'email-anda@gmail.com'
MAIL_SMTP_PASS = 'app-password-gmail'
MAIL_SMTP_CRYPTO = 'tls'

#--------------------------------------------------------------------
# CRON
# Dipakai endpoint GET /cron/retry-email, /cron/reconcile-payments,
# dan /cron/expire-orders lewat header
# Authorization: Bearer <CRON_SECRET> atau X-Cron-Secret.
#--------------------------------------------------------------------
CRON_SECRET = 'ganti-dengan-token-acak-panjang'
